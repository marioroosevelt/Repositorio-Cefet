#include <stdio.h>

void exibe(float qntd[][31], float preco[][4]);

int main()
{   
    int dias = 31;
    int tipos = 4;

    float qntdVendida[tipos][dias]; //Quantidade de combustível vendida por tipo [4] a cada dia de dezembro [31]
    float precoTipo[dias][tipos]; //Preço a cada dia [31], por tipo de combustível

    for(int i = 0; i < tipos; i++){
        for(int j = 0; j < dias; j++){
            printf("Digite a quantidade de combustível, em litros, do tipo %d, que foi vendida no dia %d de dezembro:\n", i + 1, j + 1);
            scanf("%f", &qntdVendida[i][j]);
        }
    }

    for(int n = 0; n < dias; n++){
        for(int m = 0; m < tipos; m++){
            printf("Digite o valor do combustível de tipo %d, no dia %d de dezembro:\n", m + 1, n + 1);
            scanf("%f", &precoTipo[n][m]);
        }
    }

    exibe(qntdVendida, precoTipo);

    return 0;
}

void exibe(float qntd[][31], float preco[][4]){

    int qtTipo = 4;
    int qtDias = 31;
    float totalVendas = 0;
    float totalTipo = 0;

    for(int i = 0; i < qtTipo; i++){
        for(int j = 0; j < qtDias; j++){
            totalTipo += (qntd[i][j] * preco[j][i]);
        }

        printf("O total de vendas em reais, do tipo %d, no mês de dezembro foi de:\n", i + 1);
        printf("%.2f\n", totalTipo);

        totalTipo = 0;
    }

    for(int n = 0; n < qtDias; n++){
        for(int m = 0; m < qtTipo; m++){
            totalVendas += (qntd[m][n] * preco[n][m]);
        }

        printf("O total de vendas, no dia %d de dezembro foi de:\n", n + 1);
        printf("%.2f\n", totalVendas);

        totalVendas = 0;
    }
}
