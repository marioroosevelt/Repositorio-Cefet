#include <stdio.h>

int qdMagico(int matriz[][3]);

int main()
{
    int linhas = 3;
    int colunas = 3;
    int m[linhas][colunas];

    for (int i = 0; i < linhas; i++){
        for (int j = 0; j < colunas; j++)
        {
            printf("Digite um valor ineiro para a linha %d, de coluna %d:\n", i + 1, j + 1);
            scanf("%d", &m[i][j]);
        }
    }

    int valida = qdMagico(m);

    if (valida == 0){
        printf("A matriz não é um quadrado mágico\n");
    }
    else{
        printf("A matriz é um quadrado mágico\n");
    }

    return 0;
}

int qdMagico(int matriz[][3])
{

    int valida = 0;
    int somaColuna[3] = {0};
    int somaLinha[3] = {0};
    int somaDiagonal1[1] = {0};
    int somaDiagonal2[1] = {0};
    int m = 0;
    int n = 0;

    // Loop para soma de colunas por linhas
    for (int i = 0; i < 3; i++){
        for (int j = 0; j < 3; j++){
            somaLinha[i] += matriz[i][j];
        }
    }

    // Loop para soma de linhas por colunas
    for (int j = 0; j < 3; j++){
        for (int i = 0; i < 3; i++){
            somaColuna[j] += matriz[i][j];
        }
    }

    // Loop para soma da diagonal principal
    for (int i = 0; i < 3; i++){

        somaDiagonal1[0] += matriz[i][n];

        n++;
    }

    // Loop para soma da diagonal secundária
    for (int j = 2; j > -1; j--){

        somaDiagonal2[0] += matriz[m][j];

        m++;
    }

    for (int i = 0; i < 3; i++){
        if (somaLinha[i] == somaColuna[i]){
            if (somaLinha[i] == somaDiagonal1[0] && somaLinha[i] == somaDiagonal2[0]){
                valida = 1;
            }else{
                return 0;
            }
        }else{
            return 0;    
        }
    }

    if(valida == 1){
        return 1;
    }
}
